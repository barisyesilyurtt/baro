# Pilavcı Temel Reis WhatsApp Bot Ayarları

# Restoran adı
RESTAURANT_NAME=Pilavcı Temel Reis

# Menü URL'si
MENU_URL=https://uygunye.com/r/pilavci-temel-reis

# KVKK Aydınlatma Metni URL'si
KVKK_URL=https://uygunye.com/kvkk

# Aynı kullanıcıya tekrar mesaj göndermeden önce bekleme süresi (milisaniye)
# Varsayılan: 3600000 (1 saat)
# 1 saat = 3600000
# 30 dakika = 1800000
# 15 dakika = 900000
COOLDOWN_MS=3600000

# Grup mesajlarına yanıt verilsin mi? (true/false)
REPLY_TO_GROUPS=false

# Oturum verileri klasörü
SESSION_PATH=./.wwebjs_auth
