# ========================================
# 🍚 Pilavcı Temel Reis - WhatsApp Bot
# ========================================
# Meta API YOK - Tamamen ÜCRETSİZ!
# QR kod tarayarak bağlanın

# ========================================
# Restoran Bilgileri
# ========================================

# Restoran adı (mesajda görünür)
RESTAURANT_NAME=Pilavcı Temel Reis

# Menü URL'si (müşteri bu linke yönlendirilir)
MENU_URL=https://uygunye.com/r/pilavci-temel-reis

# KVKK Aydınlatma Metni URL'si
KVKK_URL=https://uygunye.com/kvkk

# ========================================
# 🔐 Şifreleme Ayarları
# ========================================

# Telefon numarası şifreleme anahtarı
# - Rastgele ve güçlü bir anahtar kullanın
# - Sitenizde de AYNI anahtar olmalı
ENCRYPTION_KEY=guclu-rastgele-32-karakterlik-key

# Token geçerlilik süresi (saat)
TOKEN_EXPIRY_HOURS=24

# ========================================
# Bot Ayarları
# ========================================

# Web arayüzü portu
PORT=3000

# Aynı kişiye tekrar mesaj gönderme süresi (milisaniye)
# 1 saat = 3600000
# 30 dakika = 1800000
# 15 dakika = 900000
# 5 dakika = 300000
COOLDOWN_MS=3600000

# Grup mesajlarına yanıt verilsin mi? (true/false)
REPLY_TO_GROUPS=false
