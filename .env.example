# ========================================
# WhatsApp Business API Ayarları
# ========================================

# Meta Business Suite'ten alacağınız bilgiler:
# https://developers.facebook.com/apps/

# Telefon Numarası ID'si (Phone Number ID)
WA_PHONE_NUMBER_ID=your_phone_number_id

# Erişim Token'ı (Access Token)
WA_ACCESS_TOKEN=your_access_token

# Webhook Doğrulama Token'ı (kendi belirlediğiniz)
WA_VERIFY_TOKEN=pilavci_temel_reis_verify

# ========================================
# 🔐 Şifreleme Ayarları (ÖNEMLİ!)
# ========================================

# Telefon numarası şifreleme anahtarı
# - 32 karakter olmalı
# - Rastgele ve güçlü bir anahtar kullanın
# - Bu anahtarı KİMSEYLE paylaşmayın
# - Sitenizde de AYNI anahtar kullanılmalı
ENCRYPTION_KEY=pilavci-temel-reis-secret-key32

# Token geçerlilik süresi (saat)
# Kullanıcı bu süre içinde linke tıklamalı
TOKEN_EXPIRY_HOURS=24

# ========================================
# Restoran Bilgileri
# ========================================

# Restoran adı
RESTAURANT_NAME=Pilavcı Temel Reis

# Menü URL'si (token bu URL'e eklenecek)
MENU_URL=https://uygunye.com/r/pilavci-temel-reis

# KVKK Aydınlatma Metni URL'si
KVKK_URL=https://uygunye.com/kvkk

# ========================================
# Uygulama Ayarları
# ========================================

# Sunucu portu
PORT=3000

# Aynı kullanıcıya tekrar mesaj göndermeden önce bekleme süresi (milisaniye)
# 1 saat = 3600000
# 30 dakika = 1800000
COOLDOWN_MS=3600000
